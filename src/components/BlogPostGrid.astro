---
import BlogPostCard from './BlogPostCard.astro';

interface Post {
  title: string;
  category: string;
  description: string;
  image: string;
  link: string;
}

interface Props {
  posts: Post[];
  variant?: 'grid' | 'list';
}

const { posts, variant = 'list' } = Astro.props;
---

<div class={`grid gap-8 ${variant === 'grid' ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3' : 'grid-cols-1'}`}>
  {posts.map((post) => (
    <a href={post.link} class="group">
      <article class={`bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden ${variant === 'list' ? 'flex' : ''}`}>
        <div class={`relative ${variant === 'list' ? 'w-1/3' : 'w-full'}`}>
          <img 
            src={post.image} 
            alt={post.title}
            class="w-full h-48 object-cover"
          />
          <span class="absolute top-4 left-4 inline-block px-3 py-1 text-sm font-medium text-primary-blue bg-white rounded-full">
            {post.category}
          </span>
        </div>
        <div class={`p-6 ${variant === 'list' ? 'w-2/3' : ''}`}>
          <h3 class="font-heading text-xl font-bold text-gray-900 group-hover:text-primary-blue transition-colors mb-2">
            {post.title}
          </h3>
          <p class="text-gray-600">{post.description}</p>
        </div>
      </article>
    </a>
  ))}
</div> 