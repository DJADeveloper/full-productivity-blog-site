---
interface Props {
  title: string;
  slug: string;
  date: Date;
  excerpt: string;
  featuredImage: string;
  category?: string;
}

const { title, slug, date, excerpt, featuredImage, category } = Astro.props;
---

<article class="group bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
  <a href={`/blog/${slug}`} class="block h-full">
    <div class="aspect-w-16 aspect-h-9 relative">
      <img
        src={featuredImage}
        alt={title}
        class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-primary/10 to-transparent"></div>
    </div>
    <div class="p-6 bg-secondary">
      {category && (
        <span class="inline-block px-3 py-1 text-sm font-medium text-accent bg-highlight/20 rounded-full mb-4">
          {category}
        </span>
      )}
      <h3 class="font-heading text-2xl font-bold text-primary mb-3 group-hover:text-accent transition-colors line-clamp-2">
        {title}
      </h3>
      <p class="font-body text-primary/80 mb-4 line-clamp-3">{excerpt}</p>
      <time datetime={date.toISOString()} class="font-body text-sm text-primary/60">
        {new Date(date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        })}
      </time>
    </div>
  </a>
</article> 