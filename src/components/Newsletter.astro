<section class="relative py-20 overflow-hidden" id="newsletter">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/newsletter-bg.jpg"
      alt="Abstract AI technology background"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-blue-600/90 to-blue-800/90"></div>
  </div>

  <div class="container relative z-10">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-white mb-4">
        Stay Updated with AI Productivity Tips
      </h2>
      <p class="text-xl text-gray-200 mb-8">
        Join our newsletter and get weekly insights on AI tools, automation strategies, and productivity hacks.
      </p>
      <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
        <input
          type="email"
          placeholder="Enter your email"
          class="flex-1 px-4 py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400"
          required
        />
        <button
          type="submit"
          class="bg-white text-blue-600 px-6 py-3 rounded-lg font-medium hover:bg-gray-100 transition-colors"
        >
          Subscribe
        </button>
      </form>
      <p class="text-sm text-gray-300 mt-4">
        We respect your privacy. Unsubscribe at any time.
      </p>
    </div>
  </div>
</section> 