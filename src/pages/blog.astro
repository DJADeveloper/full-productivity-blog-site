---
import BlogLayout from '../layouts/BlogLayout.astro';
import BlogPostGrid from '../components/BlogPostGrid.astro';

const blogPosts = [
  {
    title: "10 AI Tools That Will Transform Your Productivity",
    category: "Productivity",
    description: "Discover the top AI tools that can help you automate tasks, streamline workflows, and boost your overall productivity.",
    image: "/images/blog/ai-tools.jpg",
    link: "/blog/ai-tools-productivity"
  },
  {
    title: "The Future of Work: How AI is Changing the Workplace",
    category: "Technology",
    description: "Explore how artificial intelligence is reshaping the modern workplace and what it means for the future of work.",
    image: "/images/blog/future-work.jpg",
    link: "/blog/future-of-work-ai"
  },
  {
    title: "Mastering Time Management in the Digital Age",
    category: "Productivity",
    description: "Learn effective time management strategies to stay productive in an increasingly digital and connected world.",
    image: "/images/blog/time-management.jpg",
    link: "/blog/time-management-digital"
  }
];
---

<BlogLayout title="Blog - AI Productivity Tips and Insights">
  <!-- Page Header with Background -->
  <div class="w-full py-12 mb-12" style="background: linear-gradient(135deg, #F8F5FF, white, #F0FDF9)">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="text-center">
        <h1 class="font-heading text-4xl md:text-5xl font-bold mb-6" style="color: #1E293B">
          Latest Insights
        </h1>
        <p class="text-xl max-w-2xl mx-auto" style="color: #64748B">
          Discover the latest tips, tools, and strategies for maximizing your productivity with AI.
        </p>
      </header>
    </div>
  </div>

  <!-- Blog Posts Grid -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <BlogPostGrid posts={blogPosts} variant="list" />
  </div>
</BlogLayout> 