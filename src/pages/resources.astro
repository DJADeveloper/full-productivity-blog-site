---
import BlogLayout from '../layouts/BlogLayout.astro';

const resources = [
  {
    title: "AI Writing Assistant Guide",
    category: "Content Creation",
    description: "A comprehensive guide to using AI writing tools to improve your content creation workflow.",
    image: "/images/resources/ai-writing.jpg",
    link: "/resources/ai-writing-guide"
  },
  {
    title: "Automation Workflow Templates",
    category: "Automation",
    description: "Ready-to-use templates for automating your most common business tasks.",
    image: "/images/resources/automation.jpg",
    link: "/resources/automation-templates"
  },
  {
    title: "AI Productivity Stack",
    category: "Tools",
    description: "The essential AI tools every entrepreneur needs in their productivity stack.",
    image: "/images/resources/productivity.jpg",
    link: "/resources/productivity-stack"
  }
];
---

<BlogLayout title="Resources - AI Productivity Tools and Templates">
  <!-- Page Header with Background -->
  <div class="w-full py-12 mb-12" style="background: linear-gradient(135deg, #F8F5FF, white, #F0FDF9)">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="text-center">
        <h1 class="font-heading text-4xl md:text-5xl font-bold mb-6" style="color: #1E293B">
          Resources
        </h1>
        <p class="text-xl max-w-2xl mx-auto" style="color: #64748B">
          Explore our collection of guides, templates, and tools to enhance your productivity with AI.
        </p>
      </header>
    </div>
  </div>

  <!-- Resources Grid -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8">
      {resources.map((resource) => (
        <a href={resource.link} class="block">
          <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden">
            <div class="flex flex-col md:flex-row">
              <div class="md:w-1/3">
                <img 
                  src={resource.image} 
                  alt={resource.title}
                  class="w-full h-48 md:h-full object-cover"
                />
              </div>
              <div class="md:w-2/3 p-6 md:p-8">
                <span class="inline-block px-3 py-1 text-sm font-medium rounded-full mb-4" style="color: #2B9CFF; background-color: #F0F9FF">
                  {resource.category}
                </span>
                <h3 class="font-heading text-xl md:text-2xl font-bold mb-3 transition-colors" style="color: #1E293B">
                  {resource.title}
                </h3>
                <p style="color: #64748B">{resource.description}</p>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BlogLayout> 