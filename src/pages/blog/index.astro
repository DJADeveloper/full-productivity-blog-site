---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Blog - AI Productivity Tools and Tips">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold text-gray-900 mb-8">Latest Articles</h1>
    
    <div class="space-y-8">
      {sortedPosts.map((post) => (
        <article class="bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow">
          <a href={`/blog/${post.slug}`} class="block p-6">
            <h2 class="text-2xl font-semibold text-gray-900 mb-2 hover:text-blue-600">
              {post.data.title}
            </h2>
            <p class="text-gray-600 mb-4">{post.data.excerpt}</p>
            <div class="flex items-center text-sm text-gray-500">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString()}
              </time>
              <span class="mx-2">•</span>
              <span>{post.data.readingTime} min read</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout> 