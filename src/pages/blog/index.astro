---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPosts = [
  {
    title: "The Future of AI in Business",
    category: "Innovation",
    description: "Explore how artificial intelligence is reshaping modern business operations and decision-making processes.",
    image: "https://images.unsplash.com/photo-1620712943543-bcc4688e7485?auto=format&fit=crop&q=80&w=1800",
    date: "March 15, 2024",
    readTime: "8 min read",
    featured: true
  },
  {
    title: "Mastering ChatGPT for Business",
    category: "AI Tools",
    description: "Learn advanced techniques to leverage ChatGPT for enhanced business productivity and automation.",
    image: "https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&q=80&w=1800",
    date: "March 12, 2024",
    readTime: "6 min read"
  },
  {
    title: "AI Productivity Tools Comparison",
    category: "Reviews",
    description: "An in-depth comparison of the top AI productivity tools to help you choose the right ones for your workflow.",
    image: "https://images.unsplash.com/photo-1673187359209-2a7015992ee3?auto=format&fit=crop&q=80&w=1800",
    date: "March 10, 2024",
    readTime: "10 min read"
  }
];
---

<Layout title="Blog - AI Productivity Insights">
  <div class="pt-32">
    <!-- Hero Section -->
    <div class="w-full py-16 mb-16" style="background: linear-gradient(135deg, #F8F5FF, white, #F0FDF9)">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <header class="text-center max-w-3xl mx-auto">
          <h1 class="font-heading text-4xl md:text-6xl font-bold mb-6" style="color: #1E293B">
            AI Productivity Insights
          </h1>
          <p class="text-xl md:text-2xl mb-8" style="color: #64748B">
            Expert guidance on leveraging artificial intelligence to transform your workflow and boost productivity.
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href="#featured" class="inline-flex items-center px-6 py-3 rounded-full text-white font-medium transition-all duration-300" style="background-color: #2B9CFF">
              Featured Articles
            </a>
            <a href="#latest" class="inline-flex items-center px-6 py-3 rounded-full font-medium border transition-all duration-300" style="color: #2B9CFF; border-color: #2B9CFF">
              Latest Posts
            </a>
          </div>
        </header>
      </div>
    </div>

    <!-- Featured Posts -->
    <section id="featured" class="mb-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
          {featuredPosts.map((post, index) => (
            <div class={`${index === 0 ? 'md:col-span-2' : ''}`}>
              <a href={`/blog/${post.title.toLowerCase().replace(/\s+/g, '-')}`} class="group block h-full">
                <article class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden h-full flex flex-col">
                  <div class="relative">
                    <img 
                      src={post.image} 
                      alt={post.title}
                      class={`w-full object-cover ${index === 0 ? 'h-[400px]' : 'h-[300px]'}`}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                    <span class="absolute top-4 left-4 inline-block px-3 py-1 text-sm font-medium rounded-full bg-white/90" style="color: #2B9CFF">
                      {post.category}
                    </span>
                  </div>
                  <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <div class="flex items-center gap-4 mb-4 text-sm" style="color: #64748B">
                      <time datetime={post.date}>{post.date}</time>
                      <span>•</span>
                      <span>{post.readTime}</span>
                    </div>
                    <h2 class={`font-heading font-bold mb-4 transition-colors ${index === 0 ? 'text-3xl' : 'text-2xl'}`} style="color: #1E293B">
                      {post.title}
                    </h2>
                    <p class="mb-6 flex-grow" style="color: #64748B">{post.description}</p>
                    <div class="inline-flex items-center text-sm font-medium transition-colors" style="color: #2B9CFF">
                      Read Article
                      <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </div>
                  </div>
                </article>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Latest Posts -->
    <section id="latest" class="mb-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-3xl font-bold mb-12" style="color: #1E293B">Latest Articles</h2>
        <div class="grid gap-8">
          {sortedPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="group">
              <article class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden">
                <div class="flex flex-col md:flex-row md:h-64">
                  <div class="md:w-1/3 relative">
                    <img 
                      src={post.data.image || "https://images.unsplash.com/photo-1674027444485-cec3da58eef4?auto=format&fit=crop&q=80&w=800"}
                      alt={post.data.title}
                      class="w-full h-48 md:h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-gradient-to-br from-black/10 to-transparent"></div>
                  </div>
                  <div class="md:w-2/3 p-6 md:p-8 flex flex-col">
                    <div class="flex items-center gap-4 mb-4 text-sm" style="color: #64748B">
                      <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString()}</time>
                      <span>•</span>
                      <span>{post.data.readingTime} min read</span>
                    </div>
                    <h3 class="font-heading text-xl md:text-2xl font-bold mb-3" style="color: #1E293B">
                      {post.data.title}
                    </h3>
                    <p class="flex-grow" style="color: #64748B">{post.data.excerpt}</p>
                    <div class="mt-4">
                      <span class="inline-flex items-center text-sm font-medium transition-colors" style="color: #2B9CFF">
                        Read Article
                        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                      </span>
                    </div>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout> 